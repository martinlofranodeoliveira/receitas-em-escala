  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "vite": "8.0.13"
  },
  "description": "Receitas e planejamento de porções com cálculos exatos, lista de compras e backup JSON local.",
